using UnityEngine;

public class DistanceDetection : MonoBehaviour
{
    public Transform player;
    public float detectRange = 5f;

    void Update()
    {
        float distance = Vector2.Distance(
            transform.position,
            player.position
        );

        if(distance <= detectRange)
        {
            Debug.Log("Player Detected");
        }
    }
}
